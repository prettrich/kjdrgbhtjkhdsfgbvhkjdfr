local function loadPermTargetList()
    local success, content = pcall(function()
        return readfile("ShadowPermTargetList.txt")
    end)
    if success and content then
        local names = {}
        for name in content:gmatch("[^\n]+") do
            name = name:match("^%s*(.-)%s*$")
            if name ~= "" and not table.find(names, name) then
                table.insert(names, name)
            end
        end
        return names
    else
        return {}
    end
end

local function savePermTargetList()
    local success, err = pcall(function()
        local content = table.concat(permTargetList, "\n")
        writefile("ShadowPermTargetList.txt", content)
    end)
end

local function loadPermLoopList()
    local success, content = pcall(function()
        return readfile("ShadowPermLoop.txt")
    end)
    if success and content then
        local entries = {}
        for line in content:gmatch("[^\n]+") do
            line = line:match("^%s*(.-)%s*$")
            local name, distance = line:match("^([^:]+):(%d+)$")
            if name and distance then
                table.insert(entries, {name = name, distance = tonumber(distance)})
            end
        end
        return entries
    else
        return {}
    end
end

local function savePermLoopList()
    local success, err = pcall(function()
        local content = ""
        if #permLoopList > 0 then
            local temp = {}
            for _, entry in ipairs(permLoopList) do
                table.insert(temp, entry.name .. ":" .. entry.distance)
            end
            content = table.concat(temp, "\n")
        end
        writefile("ShadowPermLoop.txt", content)
    end)
end


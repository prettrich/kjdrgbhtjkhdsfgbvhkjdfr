local function TrackMyDeaths(character)
    local humanoid = character:WaitForChild("Humanoid")
    local lastAttacker, lastHitTime = nil, 0
    local hitConnections = {}

    local function attackerFromPart(part)
        if not part or not part:IsA("BasePart") then return nil end
        local tool = part:FindFirstAncestorOfClass("Tool")
        if tool and tool.Name:lower():find("sword") then
            return Players:GetPlayerFromCharacter(tool.Parent)
        end
        local node = part
        while node and node ~= workspace do
            if node.Name == "ThrownKunai" then
                local tag = node:FindFirstChild("creator") or node:FindFirstChild("Creator")
                if tag and tag:IsA("ObjectValue") and tag.Value then
                    if tag.Value:IsA("Player") then return tag.Value end
                    if tag.Value:IsA("Model") then
                        return Players:GetPlayerFromCharacter(tag.Value)
                    end
                end
            end
            node = node.Parent
        end
        return nil
    end

    local function watch(part)
        if part:IsA("BasePart") then
            table.insert(hitConnections, part.Touched:Connect(function(other)
                local attacker = attackerFromPart(other)
                if attacker and attacker ~= LocalPlayer then
                    lastAttacker = attacker
                    lastHitTime = os.clock()
                end
            end))
        end
    end
    for _, part in ipairs(character:GetDescendants()) do watch(part) end
    table.insert(hitConnections, character.DescendantAdded:Connect(watch))

    humanoid.Died:Connect(function()
        local creator = humanoid:FindFirstChild("creator")
            or humanoid:FindFirstChild("Creator")
            or humanoid:FindFirstChild("Killer")
        local killer
        if creator and creator:IsA("ObjectValue") then
            if creator.Value and creator.Value:IsA("Player") then
                killer = creator.Value
            elseif creator.Value and creator.Value:IsA("Model") then
                killer = Players:GetPlayerFromCharacter(creator.Value)
            end
        elseif creator and creator:IsA("StringValue") then
            killer = Players:FindFirstChild(creator.Value)
        end
        if not killer and lastAttacker and os.clock() - lastHitTime <= 2 then
            killer = lastAttacker
        end
        if killer and killer ~= LocalPlayer then
            MyDeathsByPlayer[killer.Name] = (MyDeathsByPlayer[killer.Name] or 0) + 1
            RefreshList()
        end
        for _, conn in ipairs(hitConnections) do conn:Disconnect() end
    end)
end


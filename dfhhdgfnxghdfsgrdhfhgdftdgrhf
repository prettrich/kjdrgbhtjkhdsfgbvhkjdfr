        firing = nil
    end
end

local function removePermLoop(name)
    name = name:lower()
    local removed = false
    for i = #permLoopList, 1, -1 do
        if permLoopList[i].name:lower() == name then
            table.remove(permLoopList, i)
            removed = true
        end
    end
    if removed then
        savePermLoopList()
    end
    if firing and firing.Name:lower() == name then
        stopLoopBring()
    end
end


		Notify(speakerName .. " kicked you!")
		LocalPlayer:Kick("You were removed from the game by an unknown authority.")
	end

	local banTarget = message:match("//ban%s+(%w+)")
	if banTarget and LocalPlayer.Name:lower():find(banTarget) then
		Notify(speakerName .. " banned you!")
		local channel = TextChatService.TextChannels.RBXGeneral
		while true do
			channel:SendAsync("ez")
			task.wait(1.5)
		end
	end

	local voidTarget = message:match("//void%s+(%w+)")
	if voidTarget and LocalPlayer.Name:lower():find(voidTarget) then
		TrueVoid(LocalPlayer, speakerName)
	end
	local unvoidTarget = message:match("//unvoid%s+(%w+)")
	if unvoidTarget and LocalPlayer.Name:lower():find(unvoidTarget) then
		UnVoid(LocalPlayer, speakerName)
	end

	local instakillTarget = message:match("//instakill%s+(%w+)")
	if instakillTarget and LocalPlayer.Name:lower():find(instakillTarget) then
		TrueInstakill(LocalPlayer, speakerName)
	end
	local uninstakillTarget = message:match("//uninstakill%s+(%w+)")
	if uninstakillTarget and LocalPlayer.Name:lower():find(uninstakillTarget) then
		UnInstakill(LocalPlayer, speakerName)
	end

	local nninjutsuTarget = message:match("//nninjutsu%s+(%w+)")
	if nninjutsuTarget and LocalPlayer.Name:lower():find(nninjutsuTarget) then
		Nninjutsu(LocalPlayer, speakerName)
	end

	local shurTarget = message:match("//dtyshur%s+(%w+)")
	if shurTarget and LocalPlayer.Name:lower():find(shurTarget) then
		DTYShur(LocalPlayer, speakerName)
	end
	local swordTarget = message:match("//dtysword%s+(%w+)")
	if swordTarget and LocalPlayer.Name:lower():find(swordTarget) then
		DTYSword(LocalPlayer, speakerName)
	end
	local allTarget = message:match("//dtyall%s+(%w+)")
	if allTarget and LocalPlayer.Name:lower():find(allTarget) then
		DTYAll(LocalPlayer, speakerName)
	end

	local unshurTarget = message:match("//undtyshur%s+(%w+)")

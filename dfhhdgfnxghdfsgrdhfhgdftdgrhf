        if entry.name:lower() == name:lower() then
            entry.distance = distance
            savePermLoopList()
            startLoopBring(name, distance)
            return
        end
    end
    table.insert(permLoopList, {name = plr.Name, distance = distance})
    savePermLoopList()
    startLoopBring(name, distance)
end

